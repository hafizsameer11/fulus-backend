NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

DATABASE_URL="mysql://fulus:fulus@127.0.0.1:3306/fulus"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
REFERRAL_REWARD_NGN=500
# Optional: scripts only. Staff console uses seeded AdminUser (see prisma seed).
# ADMIN_API_KEY=

# When 1 (default in non-production), fake provider responses so demos work without keys
SIMULATE_PROVIDERS=1

# Pagocards — Visa 404 BIN (product us_404_visa_bin) via POST /api/v1/cards
PAGOCARDS_BASE_URL=https://pagocards.com
PAGOCARDS_PUBLIC_KEY=
PAGOCARDS_SECRET_KEY=

# Busha — master float (deposit VA + bank withdraw pay_out)
# Live bank withdraw needs BUSHA_SECRET_KEY + SIMULATE_PROVIDERS=0 and funded master NGN
BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_SECRET_KEY=
BUSHA_PUBLIC_KEY=
BUSHA_PROFILE_ID=
BUSHA_WEBHOOK_SECRET=

# Prembly — KYC / identity (Secret Key only; https://docs.prembly.com/docs/authentication)
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=
# Optional / legacy — newest docs do not require app-id
PREMBLY_APP_ID=

# Strowallet — bill payments
STROWALLET_BASE_URL=https://strowallet.com
STROWALLET_PUBLIC_KEY=
STROWALLET_SECRET_KEY=

# eSIM Go — https://docs.esim-go.com/
# Portal: Account Settings → API Details → API key (X-API-Key header)
# For live orders also set SIMULATE_PROVIDERS=0 and fund the org balance.
# eSIM Go — https://docs.esim-go.com/
# Portal → Account Settings → API Details: API key + Callback URL
# Callback URL: https://YOUR_API_HOST/api/v1/webhooks/esim-go  (set Callback Version to V3)
ESIM_GO_BASE_URL=https://api.esim-go.com/v2.5
ESIM_GO_API_KEY=

# Flutterwave — app EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY must match API secret mode
# Testing: both TEST (FLWPUBK_TEST + FLWSECK_TEST). Live public + live secret for production.
# Dashboard → Test mode → Settings → API keys → copy Secret key here
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_SECRET_KEY=
# Optional: if primary is LIVE, set this so sandbox app charges can still verify
FLUTTERWAVE_TEST_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# 1 = credit on app checkout success (no Flutterwave verify). Set 0 to re-enable server verify.
FLUTTERWAVE_TRUST_CLIENT_SUCCESS=1
# Optional (legacy redirect). Inline checkout uses postMessage instead.
FLUTTERWAVE_REDIRECT_URL=

# Email via custom SMTP (Hostinger example)
# Host: smtp.hostinger.com | Port 465 (SSL) or 587 (TLS with SMTP_SECURE=false)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fulus <noreply@fulusapp.co>"
