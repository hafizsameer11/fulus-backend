NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

DATABASE_URL="mysql://fulus:fulus@127.0.0.1:3306/fulus"

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=fulus-admin-dev-key

# When 1 (default in non-production), fake provider responses so demos work without keys
SIMULATE_PROVIDERS=1

# Pagocards — Visa BIN 43 virtual cards
PAGOCARDS_BASE_URL=https://pagocards.com
PAGOCARDS_PUBLIC_KEY=
PAGOCARDS_SECRET_KEY=

# Busha — crypto
BUSHA_BASE_URL=https://api.sandbox.busha.so
BUSHA_SECRET_KEY=
BUSHA_PUBLIC_KEY=
BUSHA_PROFILE_ID=

# Prembly — KYC / identity
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=
PREMBLY_APP_ID=

# Strowallet — bill payments
STROWALLET_BASE_URL=https://strowallet.com
STROWALLET_PUBLIC_KEY=
STROWALLET_SECRET_KEY=

# eSIM Go — https://docs.esim-go.com/
# Portal: Account Settings → API Details → API key (X-API-Key header)
# For live orders also set SIMULATE_PROVIDERS=0 and fund the org balance.
ESIM_GO_BASE_URL=https://api.esim-go.com/v2.5
ESIM_GO_API_KEY=

# Email via custom SMTP (Hostinger example)
# Host: smtp.hostinger.com | Port 465 (SSL) or 587 (TLS with SMTP_SECURE=false)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fulus <noreply@fulusapp.co>"
